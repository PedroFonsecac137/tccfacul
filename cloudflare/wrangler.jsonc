{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "incluiedu",
  "main": "src/index.js",
  "compatibility_date": "2026-09-04",
  "observability": { "enabled": true },
  "ai": { "binding": "AI" },
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true,
    "not_found_handling": "single-page-application"
  },
  "account_id": "e0c92a9887bbdee2eefd508c4c2be222",
  "d1_databases": [{
    "binding": "DB",
    "database_name": "incluiedu-db",
    "database_id": "934ea86d-4a8a-4f97-813c-86674ba8c020",
    "migrations_dir": "./migrations"
  }]
}
